# API da CISS (aloparacim.dataciss.com.br)
# Todos têm padrão embutido em server/utils/catalogo.ts — defina aqui só para sobrescrever.

CISS_BASE_URL=https://aloparacim.dataciss.com.br
CISS_ID_LOJA=0001
CISS_USER=109
CISS_PASS=123456
CISS_CLIENT_ID=cisspoder-oauth
CISS_CLIENT_SECRET=poder7547

# Por quanto tempo o catálogo é considerado válido antes de revalidar (em minutos).
# A origem é frágil: não abaixe muito. Padrão 360 (6h).
CATALOGO_TTL_MIN=360

# Google Analytics (GA4). Tem padrão embutido em nuxt.config.ts — defina aqui só
# para apontar para outra propriedade (ex.: sandbox de teste).
NUXT_PUBLIC_GTAG_ID=G-TWY1RG29N2

# Cosmos (Bluesoft) — https://cosmos.bluesoft.com.br — segunda fonte de imagem,
# só para os produtos que a CISS não tem foto nenhuma (ver enriquecerComCosmos
# em server/utils/catalogo.ts). SEM TOKEN, o enriquecimento não roda — é opcional.
# Plano Basic: 25 consultas/dia. Ajuste COSMOS_LIMITE_DIARIO se o plano mudar.
COSMOS_TOKEN=
COSMOS_LIMITE_DIARIO=25
